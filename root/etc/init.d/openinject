#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

OI_BIN=/usr/bin/openinject
MIHOMO_BIN=/usr/bin/mihomo
OI_CONF=/etc/openinject.json
MIHOMO_CONF=/etc/mihomo-openinject.yaml

service_triggers() {
	procd_add_reload_trigger "openinject"
}

reload_service() {
	restart
}

resolve_and_route() {
	# 1. Prioritaskan front host (bug host) karena ini IP fisik tujuan koneksi TCP pertama openinject!
	local front_host=$(sed -n 's/.*"front": *"\(.*\)".*/\1/p' "$OI_CONF" | head -1)
	front_host=${front_host%%:*}
	[ -z "$front_host" ] && front_host=$(sed -n 's/.*"bug_host": *"\(.*\)".*/\1/p' "$OI_CONF" | head -1)

	local target_host="$front_host"
	[ -z "$target_host" ] && target_host=$(sed -n 's/.*"ssh_host": *"\(.*\)".*/\1/p' "$OI_CONF" | head -1)

	[ -z "$target_host" ] && { logger -t openinject "target host kosong di $OI_CONF, abort"; return 1; }

	local wan_if=$(uci -q get network.wan.device || echo eth1)
	local wan_gw=$(ip route show default | awk '/via/ {print $3; exit}')
	[ -z "$wan_gw" ] && wan_gw=192.168.2.1

	local target_ip=""
	if echo "$target_host" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
		target_ip="$target_host"
	else
		# Jika nama domain, coba resolve
		target_ip=$(nslookup "$target_host" 192.168.2.1 2>/dev/null | awk '/^Address/ {print $NF; exit}')
		[ -z "$target_ip" ] && target_ip=$(nslookup "$target_host" 8.8.8.8 2>/dev/null | awk '/^Address/ {print $NF; exit}')
		[ -z "$target_ip" ] && target_ip=$(nslookup "$target_host" 1.1.1.1 2>/dev/null | awk '/^Address/ {print $NF; exit}')
	fi

	if [ -n "$target_ip" ]; then
		ip route replace "$target_ip/32" via "$wan_gw" dev "$wan_if"
		logger -t openinject "anti-loop route: $target_ip/32 via $wan_gw dev $wan_if"
	else
		logger -t openinject "Warning: resolve $target_host gagal, lanjut tanpa route static khusus"
	fi
	return 0
}

dns_hijack_on() {
	[ "$(uci -q get openinject.config.dns_hijack)" = "1" ] || return 0
	uci -q del_list dhcp.@dnsmasq[0].server="127.0.0.1#5353"
	uci -q add_list dhcp.@dnsmasq[0].server="127.0.0.1#5353"
	uci -q set dhcp.@dnsmasq[0].noresolv="1"
	uci commit dhcp
	/etc/init.d/dnsmasq restart
	logger -t openinject "DNS hijack ON (dnsmasq -> 127.0.0.1#5353)"
}

dns_hijack_off() {
	uci -q del_list dhcp.@dnsmasq[0].server="127.0.0.1#5353"
	uci -q delete dhcp.@dnsmasq[0].noresolv 2>/dev/null
	uci commit dhcp
	/etc/init.d/dnsmasq restart 2>/dev/null
	logger -t openinject "DNS hijack OFF"
}

# Sinkron UCI -> /etc/openinject.json (format ala HTTP Custom)
# proxy = bug host depan (front); ssh_field = host:port@user:pass
sync_config() {
	local proxy=$(uci -q get openinject.config.proxy)
	local ssh_field=$(uci -q get openinject.config.ssh_field)
	[ -z "$proxy" ] && { logger -t openinject "proxy kosong, abort sync"; return 1; }
	[ -z "$ssh_field" ] && { logger -t openinject "ssh_field kosong, abort sync"; return 1; }

	# proxy: host[:port]
	local front_host=${proxy%%:*}
	local front_port=${proxy##*:}
	[ "$front_host" = "$front_port" ] && front_port=80

	# ssh_field: host:port@user:pass  (user/pass boleh mengandung ':')
	local cred=${ssh_field##*@}
	local hostport=${ssh_field%%@*}
	local ssh_user=${cred%%:*}
	local ssh_pass=${cred#*:}
	local ssh_host=${hostport%%:*}
	local ssh_port=${hostport##*:}
	case "$hostport" in
		*:*) ;;
		*) ssh_port=22 ;;
	esac
	[ -z "$ssh_user" ] || [ "$ssh_user" = "$cred" ] && { logger -t openinject "ssh_field format salah (butuh host:port@user:pass), abort"; return 1; }

	python3 -c "import json, subprocess, re

# Ambil raw payload langsung dari UCI via subprocess
try:
    raw_payload = subprocess.check_output(['uci', '-q', 'get', 'openinject.config.payload'], text=True)
except Exception:
    raw_payload = ''

clean_payload = re.sub(r'[\r\n]+', '', raw_payload).strip()

data = {
  'listen': '0.0.0.0:1081',
  'front': '$front_host:$front_port',
  'ssh_host': '$ssh_host',
  'ssh_port': int('$ssh_port'),
  'ssh_user': '$ssh_user',
  'ssh_password': '''$ssh_pass''',
  'bug_host': '$front_host',
  'payload': clean_payload
}

with open('$OI_CONF', 'w') as f:
    json.dump(data, f, indent=2)
"
	logger -t openinject "config synced: front=$front_host:$front_port ssh=$ssh_host:$ssh_port user=$ssh_user"
	return 0
}

start_service() {
	[ "$(uci -q get openinject.config.enabled)" = "1" ] || { logger -t openinject "disabled via UCI"; return 0; }
	sync_config || return 1
	resolve_and_route || return 1

	# 1) openinject dulu (backend SOCKS5 harus siap sebelum mihomo)
	procd_open_instance openinject
	procd_set_param command "$OI_BIN" -config "$OI_CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# 2) mihomo core (TUN interface 'Meta')
	procd_open_instance mihomo
	procd_set_param command "$MIHOMO_BIN" -f "$MIHOMO_CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param env MIHOMO_LOG_FILE=/tmp/mihomo-openinject.log
	procd_close_instance

	dns_hijack_on
	logger -t openinject "STARTED: openinject -> mihomo TUN"
}

stop_service() {
	dns_hijack_off
	# procd mematikan kedua instance otomatis; TUN Meta ikut hilang
	ip link del Meta 2>/dev/null
	logger -t openinject "STOPPED"
}

restart_service() {
	stop_service
	start_service
}

status_service() {
	pgrep -f "$OI_BIN" >/dev/null && echo "openinject: RUNNING" || echo "openinject: STOPPED"
	pgrep -f "$MIHOMO_BIN" >/dev/null && echo "mihomo: RUNNING" || echo "mihomo: STOPPED"
	ip link show Meta >/dev/null 2>&1 && echo "TUN Meta: UP" || echo "TUN Meta: DOWN"
}
